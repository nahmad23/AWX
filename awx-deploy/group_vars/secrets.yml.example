---
# ------------------------------------------------------------------
# SECRETS TEMPLATE -- copy to secrets.yml and encrypt with ansible-vault.
#
#   cp group_vars/secrets.yml.example group_vars/secrets.yml
#   ansible-vault encrypt group_vars/secrets.yml
#
# secrets.yml is git-ignored and must NEVER be committed.
# ------------------------------------------------------------------

# SSH connection to the Ubuntu server that hosts AWX:
ansible_ssh_pass: "CHANGE_ME"        # <-- the server password (rotate the default!)
ansible_become_pass: "CHANGE_ME"     # if sudo needs a password (often same as above)

# SSH credentials AWX uses to reach the 10 MANAGED servers.
# These become the AWX "Machine" credential used by the ping job.
managed_ssh_user: "root"
managed_ssh_pass: "CHANGE_ME"        # or use managed_ssh_key below instead
# managed_ssh_key: |
#   -----BEGIN OPENSSH PRIVATE KEY-----
#   ...
#   -----END OPENSSH PRIVATE KEY-----

# AWX admin password to SET on install and use for API calls afterwards:
awx_admin_password: "CHANGE_ME"
